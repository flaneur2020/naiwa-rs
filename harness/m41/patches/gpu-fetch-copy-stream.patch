     impl CopyStream {
+        /// Same lifetime and completion contract as queue_async; source must be CUDA registered.
+        pub unsafe fn queue_fetch(
+            &self,
+            fence: &ReadFence,
+            parts: &[(&SlotMemory, &[u8])],
+        ) -> Result<()> {
+            self.stream.context().bind_to_thread().map_err(Error::wrap)?;
+            if let Some(event) = fence.event.lock().unwrap().as_ref() {
+                self.stream.wait(event).map_err(Error::wrap)?;
+            }
+            for (dst, src) in parts {
+                if src.len() != dst.len { candle_core::bail!("fetch source/slot length mismatch"); }
+                let mut alias = 0;
+                // Registration belongs to the layer and outlives its completion event.
+                unsafe { sys::cuMemHostGetDevicePointer_v2(&mut alias, src.as_ptr() as *mut _, 0) }
+                    .result().map_err(Error::wrap)?;
+                let rc = unsafe { naiwa_fetch_projection(dst.ptr, alias, src.len(), self.stream.cu_stream().cast()) };
+                if rc != 0 { candle_core::bail!("GPU fetch launch failed: CUDA runtime error {rc}"); }
+            }
+            Ok(())
+        }
