+    /// A mapped pinned descriptor block: the host writes it, the device reads it.
+    pub(super) struct MappedDesc {
+        host: *mut u64,
+        dev: u64,
+        cap: usize,
+    }
+
+    // SAFETY: the pointers are a live mapped allocation owned by this struct; it is only
+    // touched under the `desc` lock, and the device reads it only from the launch that
+    // follows the write.
+    unsafe impl Send for MappedDesc {}
+
+    impl MappedDesc {
+        fn new(cap: usize) -> Result<Self> {
+            let bytes = cap * std::mem::size_of::<u64>();
+            let host = unsafe {
+                result::malloc_host(
+                    bytes,
+                    sys::CU_MEMHOSTALLOC_DEVICEMAP | sys::CU_MEMHOSTALLOC_PORTABLE,
+                )
+            }
+            .map_err(Error::wrap)? as *mut u64;
+            let mut dev = 0u64;
+            unsafe { sys::cuMemHostGetDevicePointer_v2(&mut dev, host.cast(), 0) }
+                .result()
+                .map_err(Error::wrap)?;
+            Ok(Self { host, dev, cap })
+        }
+    }
+
+    impl Drop for MappedDesc {
+        fn drop(&mut self) {
+            if !self.host.is_null() {
+                unsafe { result::free_host(self.host.cast()) }.ok();
+            }
+        }
+    }
