+#[cfg(all(test, feature = "cuda"))]
+mod fetch_bandwidth {
+    use candle_core::cuda::cudarc::driver::{sys, DevicePtr};
+
+    /// `cargo test --release --features cuda --bin naiwa-rs h2d_fetch_vs_memcpy -- --ignored --nocapture`
+    #[test]
+    #[ignore = "bandwidth microbenchmark"]
+    fn h2d_fetch_vs_memcpy() {
+        let device = candle_core::Device::new_cuda(0).expect("cuda");
+        let cuda = device.as_cuda_device().expect("cuda device");
+        let cs = crate::copy_stream::CopyStream::new(&device).unwrap().unwrap();
+        for len in [700usize << 10, 2 << 20, 8 << 20] {
+            let mut src: Vec<u8> = (0..len).map(|i| (i.wrapping_mul(31) & 255) as u8).collect();
+            let ptr = src.as_mut_ptr();
+            unsafe { sys::cuMemHostRegister_v2(ptr.cast(), len, sys::CU_MEMHOSTREGISTER_PORTABLE) }
+                .result().unwrap();
+            let mut alias = 0u64;
+            unsafe { sys::cuMemHostGetDevicePointer_v2(&mut alias, ptr.cast(), 0) }.result().unwrap();
+            let mut dst = unsafe { cuda.alloc::<u8>(len) }.unwrap();
+            let stream = cs.stream_for_bench();
+            let dptr = { let (p, guard) = dst.device_ptr(&stream); let raw = p; drop(guard); raw };
+            let iters = (512usize << 20) / len;
+            cs.memcpy_for_bench(&src, &mut dst).unwrap();
+            cs.bench_fetch(dptr, alias, len).unwrap();
+            cs.sync_for_bench().unwrap();
+            let t = std::time::Instant::now();
+            for _ in 0..iters { cs.memcpy_for_bench(&src, &mut dst).unwrap(); }
+            cs.sync_for_bench().unwrap();
+            let memcpy_s = t.elapsed().as_secs_f64();
+            let t = std::time::Instant::now();
+            for _ in 0..iters { cs.bench_fetch(dptr, alias, len).unwrap(); }
+            cs.sync_for_bench().unwrap();
+            let fetch_s = t.elapsed().as_secs_f64();
+            let gbs = |s: f64| (len as f64 * iters as f64) / s / 1e9;
+            println!("len {:>9}  iters {:>5}  memcpy {:.2} GB/s   fetch {:.2} GB/s   ratio {:.2}",
+                len, iters, gbs(memcpy_s), gbs(fetch_s), gbs(fetch_s) / gbs(memcpy_s));
+            unsafe { sys::cuMemHostUnregister(ptr.cast()) }.result().unwrap();
+        }
+    }
