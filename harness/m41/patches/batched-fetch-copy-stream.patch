+            }
+            let rc = unsafe { naiwa_fetch_projection(dst, src_alias, len, self.stream.cu_stream().cast()) };
+            if rc != 0 { candle_core::bail!("fetch launch failed: {rc}"); }
+            Ok(())
+        }
