+
+        #[cfg(test)]
+        pub fn memcpy_for_bench(&self, src: &[u8], dst: &mut candle_core::cuda::cudarc::driver::CudaSlice<u8>) -> Result<()> {
+            self.stream.memcpy_htod(src, dst).map_err(Error::wrap)
