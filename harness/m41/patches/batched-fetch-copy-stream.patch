+
+        #[cfg(test)]
+        pub fn sync_for_bench(&self) -> Result<()> { self.stream.synchronize().map_err(Error::wrap) }
+
+        /// One launch for every part of a layer's staging batch; the sources stay registered for
+        /// the model's lifetime, so their device aliases are cached after the first use.
+        pub unsafe fn queue_fetch_batch(
+            &self,
+            fences: &[&ReadFence],
+            parts: &[(&SlotMemory, &[u8])],
+        ) -> Result<()> {
+            extern "C" {
+                fn naiwa_fetch_batch(desc: u64, n: i32, stream: *mut std::ffi::c_void) -> i32;
+            }
+            self.stream.context().bind_to_thread().map_err(Error::wrap)?;
+            for fence in fences {
+                if let Some(event) = fence.event.lock().unwrap().as_ref() {
+                    self.stream.wait(event).map_err(Error::wrap)?;
+                }
+            }
+            let mut words: Vec<u64> = Vec::with_capacity(parts.len() * 3);
+            for (dst, src) in parts {
+                if src.len() != dst.len {
+                    candle_core::bail!("fetch source/slot length mismatch");
+                }
+                words.push(dst.ptr);
+                words.push(self.alias_of(src.as_ptr())?);
+                words.push(src.len() as u64);
+            }
+            let mut guard = self.desc.lock().unwrap();
+            if guard.as_ref().map_or(true, |d| d.cap < words.len()) {
+                *guard = Some(MappedDesc::new(words.len().next_power_of_two().max(64))?);
+            }
+            let desc = guard.as_ref().unwrap();
+            // SAFETY: `words` fits the mapping (`cap` checked above); a fence separates the previous
+            // batch's device read from this write.
+            unsafe { std::ptr::copy_nonoverlapping(words.as_ptr(), desc.host, words.len()) };
+            let rc = naiwa_fetch_batch(desc.dev, parts.len() as i32, self.stream.cu_stream().cast());
+            if rc != 0 {
+                candle_core::bail!("batch fetch launch failed: CUDA runtime error {rc}");
+            }
+            Ok(())
+        }
+
+        /// Device alias of registered host memory, cached per base pointer.
+        fn alias_of(&self, host: *const u8) -> Result<u64> {
+            let mut cache = self.aliases.lock().unwrap();
+            if let Some(alias) = cache.get(&(host as usize)) {
+                return Ok(*alias);
+            }
+            let mut alias = 0u64;
+            unsafe { sys::cuMemHostGetDevicePointer_v2(&mut alias, host as *mut _, 0) }
+                .result()
+                .map_err(Error::wrap)?;
+            cache.insert(host as usize, alias);
+            Ok(alias)
+        }
+
